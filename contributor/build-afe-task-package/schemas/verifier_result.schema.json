{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "valid",
    "status",
    "primary_metric",
    "metrics",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "valid": {"type": "boolean"},
    "status": {"enum": ["valid", "invalid"]},
    "primary_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "direction"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "direction": {"enum": ["maximize", "minimize"]}
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "unit": {"type": ["string", "null"]}
        }
      }
    },
    "error": {"type": ["string", "null"]}
  }
}
