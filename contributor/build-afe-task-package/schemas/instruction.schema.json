{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instructions",
    "input",
    "submission",
    "environment",
    "requirement",
    "limitation"
  ],
  "properties": {
    "instructions": {"type": "string", "minLength": 1},
    "input": {
      "type": "array",
      "items": {"$ref": "#/definitions/described_path"}
    },
    "submission": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "format", "description"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "has_template": {
            "description": "Defaults to true when omitted. Set false only when a starter file is not meaningful.",
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "description"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "requirement": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {"$ref": "#/definitions/cpu_limit"},
        "memory": {"$ref": "#/definitions/memory_limit"},
        "gpu": {"$ref": "#/definitions/gpu_limit"},
        "runtime": {"$ref": "#/definitions/runtime_limit"}
      }
    }
  },
  "definitions": {
    "described_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "description"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "cpu_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cores"],
      "properties": {"cores": {"type": "integer", "minimum": 1}}
    },
    "memory_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gb"],
      "properties": {"gb": {"type": "number", "exclusiveMinimum": 0}}
    },
    "gpu_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {"count": {"type": "integer", "minimum": 0}}
    },
    "runtime_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seconds"],
      "properties": {"seconds": {"type": "integer", "minimum": 1}}
    }
  }
}
